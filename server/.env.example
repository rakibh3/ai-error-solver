# JWT Configuration
# Required: a random secret of at least 32 bytes. The server refuses to start with
# this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Database Configuration
# Single source of truth: docker-compose.yml provisions the container from
# these, and app/core/config.py builds the SQLAlchemy URL from the same values.
# User, password and db have no defaults -- `docker compose up` fails if unset.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this
POSTGRES_DB=error_solver
# Where the app dials; leave as localhost while Postgres runs in compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API Keys
# Chat generation is routed through OpenRouter (OpenAI-compatible API).
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the endpoint, e.g. for a proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: attribution on openrouter.ai rankings. Both may be left unset.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Error Navigator

# Embeddings go to Voyage directly -- OpenRouter routes chat, not embeddings.
VOYAGE_API_KEY=your-voyage-api-key

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Unset for the default unsecured local container; see docker-compose.yml to enable auth.
QDRANT_API_KEY=
# Optional: full endpoint (e.g. https://xyz.cloud.qdrant.io:6333) instead of host/port,
# and a read-only key for the analysis path. Off-host Qdrant requires https + QDRANT_API_KEY.
# QDRANT_URL=
# QDRANT_SCHEME=http
# QDRANT_READ_ONLY_API_KEY=
# docker-compose.yml only
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO

# Admin seeding — read ONLY by scripts/seed_admin.py, never by the API.
# There is no way to register as an admin; this is how the first one is made.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-something-long
ADMIN_FULLNAME=Administrator

# Upload limits. Sizes are in megabytes (MB); counts are plain numbers.
MAX_UPLOAD_MB=25
MAX_EXTRACTED_MB=50
MAX_ARCHIVE_MEMBERS=2000
MAX_MEMBER_MB=10

# Per-user quotas
USER_SUBMISSION_QUOTA=5
USER_STORAGE_QUOTA_MB=200

# Retrieval / analysis
RETRIEVAL_K=8
# Models. Required -- there is no in-code default for either.
# ANALYSIS_MODEL is an OpenRouter slug: https://openrouter.ai/models
ANALYSIS_MODEL=google/gemini-2.5-flash
# EMBEDDING_MODEL is a Voyage model. Changing it invalidates every existing
# Qdrant collection -- re-index all reference branches after a change.
EMBEDDING_MODEL=voyage-code-3
ANALYSIS_TIMEOUT_SECONDS=60
MAX_ERROR_MESSAGE_CHARS=8000
MAX_STUDENT_CONTEXT_CHARS=60000
MAX_CANDIDATE_FILES=12

# Rate limits (slowapi syntax)
AUTH_RATE_LIMIT=10/minute
# Per-account login attempts, from any IP.
LOGIN_EMAIL_RATE_LIMIT=20/hour
# Read by uvicorn, not the app: peers allowed to set X-Forwarded-For (the
# Next.js BFF). uvicorn reads it before the app loads this file, so it only
# applies from here with `uvicorn main:app --env-file .env`; otherwise export
# it or pass --forwarded-allow-ips. Change when the client does not run on this
# host. Never "*" on a public port.
FORWARDED_ALLOW_IPS=127.0.0.1
ANALYZE_RATE_LIMIT=10/hour
UPLOAD_RATE_LIMIT=20/hour

# Storage roots
REFERENCE_PROJECTS_DIR=instructor_projects
SUBMISSIONS_DIR=student_projects

# Security switches
# Serve /docs, /redoc and the OpenAPI schema. Set to false on a public API.
ENABLE_API_DOCS=true
# Hosts reference repositories may be cloned from ("*" = any https host).
REPO_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org
