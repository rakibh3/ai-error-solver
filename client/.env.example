# Copy to .env.local and adjust. Never commit real values.

# --- Server-only --------------------------------------------------------------
# FastAPI origin the BFF proxy forwards to (app/api/backend/[[...path]]).
# Read only on the Next.js server; never exposed to the browser. Must be
# reachable from the Next.js process (use the internal hostname in Docker).
BACKEND_URL=http://localhost:8000

# Session cookie `Secure` flag. Leave unset to decide per request: Secure over
# HTTPS (including behind a TLS proxy that sends X-Forwarded-Proto: https), not
# over plain HTTP. Set to "true" to force it in production if your proxy does
# not send X-Forwarded-Proto.
# SESSION_COOKIE_SECURE=true

# --- Public (inlined into the browser bundle at build time) --------------------
# UI hints and early client-side validation only; the API enforces the real
# limits. Keep these in sync with the server's values in server/.env
# (MAX_UPLOAD_MB, USER_SUBMISSION_QUOTA, USER_STORAGE_QUOTA_MB,
# MAX_ERROR_MESSAGE_CHARS). Sizes are in megabytes (MB), same as the server.
# Rebuild the client after changing them.
NEXT_PUBLIC_MAX_UPLOAD_MB=25
NEXT_PUBLIC_USER_SUBMISSION_QUOTA=5
NEXT_PUBLIC_USER_STORAGE_QUOTA_MB=200
NEXT_PUBLIC_MAX_ERROR_MESSAGE_CHARS=8000
